# CineBook Environment Configuration Example
# Copy this file to backend/.env or configure backend/.env directly

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB connection string (e.g. MongoDB Atlas or local MongoDB service).
# Example: mongodb://127.0.0.1:27017/cinebook or mongodb+srv://<username>:<password>@cluster.mongodb.net/cinebook
# If left empty or unable to connect, CineBook server will automatically start an in-memory MongoDB in development mode!
MONGODB_URI=mongodb://127.0.0.1:27017/cinebook

# JWT Secret for Authentication
# Replace with a cryptographically secure random string (at least 32 characters long).
# Generate in Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# Payment Gateway Adapter Mode
# Available: DEMO (simulated payment gateway for local testing)
PAYMENT_MODE=DEMO

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

