{
  "name": "cinebook",
  "version": "1.0.0",
  "description": "Full-Stack Movie Ticket Booking Platform with Dark Cinematic UI",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "movie-booking",
    "ticket-booking",
    "react",
    "vite",
    "tailwind",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "CineBook Team",
  "license": "MIT"
}
