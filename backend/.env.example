# ==========================================
# CineBook Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String:
# Connect to your local MongoDB service: mongodb://127.0.0.1:27017/cinebook
# Or connect to a remote MongoDB Atlas cluster: mongodb+srv://<user>:<password>@cluster.mongodb.net/cinebook
# NOTE: If left empty or local MongoDB is not running, CineBook automatically launches an in-memory MongoDB in development!
MONGODB_URI=mongodb://127.0.0.1:27017/cinebook

# JWT Secret Key (Used to cryptographically sign authentication tokens)
JWT_SECRET=cinebook_super_secret_jwt_key_development_change_in_production_2026
JWT_EXPIRES_IN=7d

# Payment Mode: DEMO (simulated payment gateway for safe testing without real money)
PAYMENT_MODE=DEMO

# Allowed Client Frontend URL for CORS
CLIENT_URL=http://localhost:5173
