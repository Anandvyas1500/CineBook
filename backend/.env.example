# ==========================================
# CineBook Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String:
# Connect to your local MongoDB service: mongodb://127.0.0.1:27017/cinebook
# Or connect to a remote MongoDB Atlas cluster: mongodb+srv://<username>:<password>@cluster.mongodb.net/cinebook
# NOTE: If left empty or local MongoDB is not running, CineBook automatically launches an in-memory MongoDB in development!
MONGODB_URI=mongodb://127.0.0.1:27017/cinebook

# JWT Secret Key (Used to cryptographically sign authentication tokens)
# Replace with a cryptographically secure random string (at least 32 characters long).
# Generate via Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Payment Mode: DEMO (simulated payment gateway for safe testing without real money)
PAYMENT_MODE=DEMO

# Allowed Client Frontend URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

